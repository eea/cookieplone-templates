{
  "title": "EEA Website Frontend",
  "project_slug": "{{ cookiecutter.title | slugify }}",
  "description": "EEA Volto frontend project",
  "author": "European Environment Agency",
  "email": "eea-edw-a-team-alerts@googlegroups.com",
  "github_organization": "eea",
  "docker_registry": "eeacms",
  "frontend_addon_name": "volto-{{ cookiecutter.project_slug }}",
  "npm_package_name": "@eeacms/{{ cookiecutter.frontend_addon_name }}",
  "volto_version": "{{ 'Yes' | latest_volto }}",
  "node_version": "{{ cookiecutter.volto_version | node_version_for_volto }}",
  "pnpm_version": "{{ '10.20.0' if cookiecutter.volto_version >= '19' else '9.15.9' }}",
  "sonarqube_tag": "{{ cookiecutter.project_slug }}",
  "rancher_stackid": "",
  "rancher_envid": "",
  "__folder_name": "{{ cookiecutter.project_slug }}",
  "__repository_url": "https://github.com/{{ cookiecutter.github_organization }}/{{ cookiecutter.project_slug }}",
  "__repository_git": "git@github.com:{{ cookiecutter.github_organization }}/{{ cookiecutter.project_slug }}",
  "__docker_image": "{{ cookiecutter.docker_registry }}/{{ cookiecutter.project_slug }}",
  "__version_frontend_package": "1.0.0-alpha.0",
  "__version_plone_volto": "{{ cookiecutter.volto_version }}",
  "__version_mrs_developer": "^2.2.0",
  "__version_pnpm": "{{ cookiecutter.pnpm_version }}",
  "__version_node": "{{ cookiecutter.node_version }}",
  "__prompts__": {
    "title": "Project Title",
    "description": "Short project description",
    "volto_version": "Volto version"
  },
  "_copy_without_render": [".github/workflows/betterleaks.yml"],
  "_extensions": [
    "cookieplone.filters.use_prerelease_versions",
    "cookieplone.filters.node_version_for_volto",
    "cookieplone.filters.latest_volto"
  ],
  "__cookieplone_repository_path": "",
  "__cookieplone_template": "frontend_project",
  "__generator_sha": "",
  "__generator_template_url": "https://github.com/eea/cookieplone-templates/tree/main/{{ cookiecutter.__cookieplone_template }}",
  "__generator_date_long": "{% now 'utc', '%Y-%m-%d %H:%M:%S' %}",
  "__generator_signature": "This was generated by [the cookieplone-templates {{ cookiecutter.__cookieplone_template }} template]({{ cookiecutter.__generator_template_url }}) on {{ cookiecutter.__generator_date_long }}"
}
